#include <iostream>
#include<vector>
#include <algorithm>
using namespace std;
int main() {
    int n,k,c=0;
    cin>>n>>k;
    vector<int> cnt(k+1,0);
    for(int i=0;i<n;i++){
        int f;
        cin>>f;
        cnt[f]++;
    }
    int m = *max_element(cnt.begin(),cnt.end());
    for(int i=1;i<=k;i++){
        if(cnt[i]>=m-1)
        c++;
    }
    cout<<c;
}
