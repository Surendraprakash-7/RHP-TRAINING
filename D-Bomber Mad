#include <iostream>
#include <vector>
#include<queue>
using namespace std;
int main() {
    int r,c,p;
    cin>>r>>c>>p;
    vector<string> g(r);
    for(int i=0;i<r;i++)
    cin>>g[i];
    vector<bool> br(r,true),bc(c,true);
    for(int i=0;i<r;i++){
        for(int j=0;j<c;j++){
            if(g[i][j] == '#')
            br[i]=bc[j]=false;
        }
    }
    queue<pair<int,int>> q;
    vector<vector<bool>> vis(r,vector<bool>(c,false));
    for(int i=0;i<r;i++){
        for(int j=0;j<c;j++){
            if(br[i] && bc[j]){
                q.push(make_pair(i,j));
                vis[i][j]=true;
            }
        }
    }
    int hops=0,cell=0;
    int d[4][4]={{-1,0},{0,-1},{1,0},{0,1}};
    while(!q.empty() && hops<=p){
       
        hops++;
        int size= q.size();
        cell+=size;
       // cout<<size<<" "<<hops<<endl;
        while(size--){
            auto[rk,ck]= q.front();
            q.pop();
            for(int k=0;k<4;k++){
                int row = rk+d[k][0];
                int col = ck+d[k][1];
                if(row<r && row>=0 && col<c && col>=0 && !vis[row][col] && g[row][col]!='#'){
                    vis[row][col]=true;
                    q.push(make_pair(row,col));
                }
            }
        }
    }
    cout<<cell<<" ";
}
