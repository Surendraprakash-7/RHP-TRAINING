#include <iostream>
#include <vector>
using namespace std;
int main() {
    int n,m;
    long long k;
    cin>>n>>m>>k;
    long long c=0;
    vector<int> a(n);
    vector<bool> eaten(n,false);
    for(int i=0;i<n;i++){
        cin>>a[i];
        if(i>=m){
            if(eaten[i-m]){
                c-=a[i-m];
            }
        }
            if(c+a[i]<=k){
                    eaten[i]=true;
                    c+=a[i];
                    cout<<"Yes\n";
                    }else{
                        cout<<"No\n";
                    }
        
    }

    return 0;
}
